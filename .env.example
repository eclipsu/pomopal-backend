# App URL used in friend-invite email links and presence WebSocket CORS
APP_URL=https://pomopal.lol

# Neon Postgres (required in production)
DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_NAME=neondb
DB_SSL=true

# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=https://pomopal.vercel.app,http://3.150.110.6:80

# Comma-separated emails promoted to admin role on login (not hardcoded in code)
# ADMIN_EMAILS=therajeevshrestha@gmail.com

# Email (pick one provider)
#
# Option A — Resend (recommended for production; verify domain in Resend dashboard)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key
# SMTP_FROM=noreply@pomopal.lol
# SMTP_FROM_NAME=Pomopal
#
# Option B — Gmail (Google App Password required; https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Pomopal

ADMIN_EMAILS=therajeevshrestha@gmail.com

# S3 — notification template images (WebP, public URLs like pomo-*.png assets)
BUCKET_NAME=pomopal
BUCKET_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Max uploaded sound size in bytes (default 500MB ≈ 2–3h MP3).
# SOUND_MAX_AUDIO_BYTES=524288000

# S3 bucket CORS must allow PUT from your admin origin for direct large uploads:
# AllowedMethods: GET, PUT, HEAD
# AllowedOrigins: https://pomopal.lol, http://localhost:3000
# AllowedHeaders: *

# YouTube audio extraction (requires a recent yt-dlp + ffmpeg on the server)
# Prefer a fresh binary over the apt package (YouTube breaks old versions often):
#   curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o ~/.local/bin/yt-dlp
#   chmod a+rx ~/.local/bin/yt-dlp
# YT_DLP_PATH=/home/you/.local/bin/yt-dlp
# YT_DLP_CONCURRENT_FRAGMENTS=8
# YOUTUBE_MAX_DURATION_SECONDS=10800
# YOUTUBE_MAX_AUDIO_BYTES=209715200
# YOUTUBE_PARSE_TIMEOUT_MS=5400000

# Giphy GIFs for Space backgrounds (free API key)
# https://developers.giphy.com/dashboard/
# GIPHY_API_KEY=your_giphy_api_key

