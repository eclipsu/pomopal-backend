# App URL used in friend-invite email links and presence WebSocket CORS
APP_URL=https://pomopal.lol

# Neon Postgres (required in production)
DB_HOST=ep-xxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_NAME=neondb
DB_SSL=true

# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=https://pomopal.vercel.app,http://3.150.110.6:80

# Email (pick one provider)
#
# Option A — Resend (recommended for production; verify domain in Resend dashboard)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key
# SMTP_FROM=noreply@pomopal.lol
# SMTP_FROM_NAME=Pomopal
#
# Option B — Gmail (Google App Password required; https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Pomopal
