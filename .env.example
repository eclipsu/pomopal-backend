# App URL used in friend-invite email links and presence WebSocket CORS
APP_URL=https://pomopal.lol

# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=https://pomopal.vercel.app

# Resend SMTP (domain must be verified in Resend dashboard)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
SMTP_FROM=noreply@pomopal.lol
SMTP_FROM_NAME=Pomopal
